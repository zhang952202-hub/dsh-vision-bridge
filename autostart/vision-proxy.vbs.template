' vision-proxy.vbs - start the vision proxy at Windows logon, no console window.
' Generated by install.ps1 - do not edit by hand.

PYTHON = "<PYTHON_PATH>"
PROXY  = "<SHIM_PATH>"
ARGS   = " --host 127.0.0.1 --port 8900 --upstream <UPSTREAM> --vision-url <VISION_URL> --vision-model <VISION_MODEL>"

Set sh = CreateObject("WScript.Shell")
sh.Run """" & PYTHON & """ """ & PROXY & """" & ARGS, 0, False
